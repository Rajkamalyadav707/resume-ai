# Server-side Vercel environment variables. Never prefix these with VITE_.
ICA_API_KEY=
ICA_API_URL=https://api.servicesessentials.ibm.com/v1
ICA_MODEL=claude-haiku-4-5
# Optional task routing. These values stay server-side. Confirm model IDs with GET /chat-models/models.
# Recommended quality/cost balance from the models available to this project:
ICA_ANALYSIS_MODEL=claude-sonnet-4-6
ICA_OPTIMIZE_MODEL=claude-sonnet-4-6
# Optional model for the resume-only chat widget.
ICA_CHAT_MODEL=claude-haiku-4-5