{
  "name": "resumeai",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node dev-server.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "node --test test/*.test.mjs",
    "format": "prettier --write api/**/*.mjs src/**/*.{ts,tsx} test/**/*.mjs *.{mjs,ts,json,html}",
    "format:check": "prettier --check api/**/*.mjs src/**/*.{ts,tsx} test/**/*.mjs *.{mjs,ts,json,html}",
    "vercel-dev": "vercel dev"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "mammoth": "latest",
    "pdf-lib": "latest",
    "pdfjs-dist": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-router-dom": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "prettier": "3.8.3",
    "typescript": "latest"
  }
}
